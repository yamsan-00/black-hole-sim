// =============================================================================
// geodesic.comp  (PATCHED)
//
// Physics fixes:
//   1.  geodesicRHS: angular terms now multiply by f (was missing)
//         d2.x += r * f * (dth*dth + sin^2(th)*dph*dph)
//       Previously the centrifugal-like terms were over-strength by 1/f near
//       the horizon, distorting the photon sphere.
//
//   2.  initRay: dt/dlambda sqrt now divides by f (was missing outer /f)
//         dt_dL = sqrt( (...)/f )   ->   sqrt( (...)/f / f ) = sqrt(.../f^2)
//       Combined with fix 1, the time-term coefficient is now consistent with
//       the angular-term coefficient (both scale as 1/f).
//
//   3.  ESCAPE_R lowered from 1e30 (unreachable in 800 steps) to 1e12.
//       Rays that escape now terminate early.
//
//   4.  float mass[16]  ->  vec4 mass[16]   (std140 layout fix)
//       In std140 a float array has 16-byte stride, so the old shader read OOB
//       for any index > 0. The C++ side was updated to upload vec4 mass[16].
//       mass[] is still unused by the shader body, but the layout is now
//       correct for future use (e.g. real N-body gravity in the integrator).
//
//   5.  SagA_rs hardcoded constant replaced by bhRs uniform from Disk UBO.
//       C++ now uploads SagA.r_s as the 3rd float in the Disk UBO.
//
//   6.  WIDTH / HEIGHT no longer hardcoded; read from Camera UBO as
//       ivec2 resolution. Supports window resize.
//
//   7.  Star field replaced with hash of ray direction (was sin-based, which
//       produced flickering stars tied to ray exit position).
//
//   8.  Object intersection switched from point-in-sphere to proper
//       segment-sphere intersection (prevents tunneling at large step sizes).
// =============================================================================

#version 430
layout(local_size_x = 16, local_size_y = 16) in;

layout(binding = 0, rgba8) writeonly uniform image2D outImage;

layout(std140, binding = 1) uniform Camera {
    vec3 camPos;     float _pad0;
    vec3 camRight;   float _pad1;
    vec3 camUp;      float _pad2;
    vec3 camForward; float _pad3;
    float tanHalfFov;
    float aspect;
    int  moving;
    int  _pad4;
    int  resX;
    int  resY;
} cam;

layout(std140, binding = 2) uniform Disk {
    float disk_r1;
    float disk_r2;
    float bhRs;                // [FIX] Schwarzschild radius (was disk_num, unused)
    float time;                // [ANIM] clock for disk rotation (was thickness, unused)
};

layout(std140, binding = 3) uniform Objects {
    int  numObjects;
    vec4 objPosRadius[16];
    vec4 objColor[16];
    vec4 mass[16];             // [FIX] was float mass[16] (std140 mismatch)
};

const float ESCAPE_R  = 1e12;  // [FIX] was 1e30 (unreachable)

struct Ray {
    float x, y, z, r, theta, phi;
    float dr, dtheta, dphi;
    float E, L;
};

Ray initRay(vec3 pos, vec3 dir) {
    Ray ray;
    ray.x = pos.x; ray.y = pos.y; ray.z = pos.z;
    ray.r = length(pos);
    ray.theta = acos(pos.z / ray.r);
    ray.phi = atan(pos.y, pos.x);

    float dx = dir.x, dy = dir.y, dz = dir.z;
    ray.dr     = sin(ray.theta)*cos(ray.phi)*dx + sin(ray.theta)*sin(ray.phi)*dy + cos(ray.theta)*dz;
    ray.dtheta = (cos(ray.theta)*cos(ray.phi)*dx + cos(ray.theta)*sin(ray.phi)*dy - sin(ray.theta)*dz) / ray.r;
    ray.dphi   = (-sin(ray.phi)*dx + cos(ray.phi)*dy) / (ray.r * sin(ray.theta));

    ray.L = ray.r * ray.r * sin(ray.theta) * ray.dphi;
    float f = 1.0 - bhRs / ray.r;

    // [FIX] null condition: dt/dlambda = (1/f) * sqrt( spatial_terms / f )
    //   -> divide the inside of the sqrt by f again (outer /f)
    float spatial = (ray.dr*ray.dr)/f
                  + ray.r*ray.r*(ray.dtheta*ray.dtheta
                                  + sin(ray.theta)*sin(ray.theta)*ray.dphi*ray.dphi);
    float dt_dL = sqrt(spatial / f);          // [FIX] was sqrt(spatial) -- missing /f
    ray.E = f * dt_dL;
    return ray;
}

bool intercept(Ray ray, float rs) { return ray.r <= rs; }

// [FIX] segment-sphere intersection (was point-in-sphere; tunneled at large dL)
bool interceptObjectSegment(vec3 prev, vec3 cur, out vec4 objCol, out vec3 hitC, out float hitR) {
    for (int i = 0; i < numObjects; ++i) {
        vec3  c = objPosRadius[i].xyz;
        float r = objPosRadius[i].w;
        vec3  ab = cur - prev;
        float abLen2 = dot(ab, ab);
        if (abLen2 < 1e-6) continue;
        float t = dot(c - prev, ab) / abLen2;
        t = clamp(t, 0.0, 1.0);
        vec3 closest = prev + t * ab;
        if (distance(closest, c) <= r) {
            objCol = objColor[i];
            hitC = c;
            hitR = r;
            return true;
        }
    }
    return false;
}

void geodesicRHS(Ray ray, out vec3 d1, out vec3 d2) {
    float r = ray.r, th = ray.theta;
    float dr = ray.dr, dth = ray.dtheta, dph = ray.dphi;
    float f = 1.0 - bhRs / r;
    float dt_dL = ray.E / f;

    d1 = vec3(dr, dth, dph);

    // Schwarzschild radial geodesic (signature +---):
    //   d2r/dL2 = -rs/(2 r^2) f (dt/dL)^2
    //           + rs/(2 r^2 f) (dr/dL)^2
    //           + r f ( (dth/dL)^2 + sin^2(th) (dph/dL)^2 )     <-- f was missing
    d2.x = - (bhRs / (2.0*r*r)) * f * dt_dL*dt_dL
         + (bhRs / (2.0*r*r*f)) * dr*dr
         + r * f * (dth*dth + sin(th)*sin(th)*dph*dph);          // [FIX] added f

    d2.y = -2.0*dr*dth/r + sin(th)*cos(th)*dph*dph;
    d2.z = -2.0*dr*dph/r - 2.0*cos(th)/sin(th) * dth * dph;
}

void rk4Step(inout Ray ray, float dL) {
    vec3 k1a, k1b; geodesicRHS(ray, k1a, k1b);
    Ray r2 = ray;
    r2.r += dL*k1a.x; r2.theta += dL*k1a.y; r2.phi += dL*k1a.z;
    r2.dr += dL*k1b.x; r2.dtheta += dL*k1b.y; r2.dphi += dL*k1b.z;
    vec3 k2a, k2b; geodesicRHS(r2, k2a, k2b);

    Ray r3 = ray;
    r3.r += dL*k2a.x; r3.theta += dL*k2a.y; r3.phi += dL*k2a.z;
    r3.dr += dL*k2b.x; r3.dtheta += dL*k2b.y; r3.dphi += dL*k2b.z;
    vec3 k3a, k3b; geodesicRHS(r3, k3a, k3b);

    Ray r4 = ray;
    r4.r += dL*k3a.x; r4.theta += dL*k3a.y; r4.phi += dL*k3a.z;
    r4.dr += dL*k3b.x; r4.dtheta += dL*k3b.y; r4.dphi += dL*k3b.z;
    vec3 k4a, k4b; geodesicRHS(r4, k4a, k4b);

    ray.r      += (dL/6.0)*(k1a.x + 2*k2a.x + 2*k3a.x + k4a.x);
    ray.theta  += (dL/6.0)*(k1a.y + 2*k2a.y + 2*k3a.y + k4a.y);
    ray.phi    += (dL/6.0)*(k1a.z + 2*k2a.z + 2*k3a.z + k4a.z);
    ray.dr     += (dL/6.0)*(k1b.x + 2*k2b.x + 2*k3b.x + k4b.x);
    ray.dtheta += (dL/6.0)*(k1b.y + 2*k2b.y + 2*k3b.y + k4b.y);
    ray.dphi   += (dL/6.0)*(k1b.z + 2*k2b.z + 2*k3b.z + k4b.z);

    ray.x = ray.r * sin(ray.theta) * cos(ray.phi);
    ray.y = ray.r * sin(ray.theta) * sin(ray.phi);
    ray.z = ray.r * cos(ray.theta);
}

// [REMOVED] crossesDisk — replaced by interpolated equatorial-plane crossing
// in main(): endpoint-only detection quantized the disk into ~0.4·rs bands.

// [FIX] hash-based star sampler (was broken sin-product field)
float hash13(vec3 p) {
    p = fract(p * 0.1031);
    p += dot(p, p.yzx + 33.33);
    return fract((p.x + p.y) * p.z);
}

// scattered horizon: blobby noise so the silhouette is irregular, not a clean sphere
float horizonJitter(vec3 p) {
    return hash13(floor(p / (bhRs * 0.06)));
}

void main() {
    ivec2 pix = ivec2(gl_GlobalInvocationID.xy);

    // [FIX] resolution comes from UBO (supports window resize)
    int WIDTH  = cam.resX;
    int HEIGHT = cam.resY;
    if (pix.x >= WIDTH || pix.y >= HEIGHT) return;

    float u = (2.0 * (pix.x + 0.5) / WIDTH - 1.0) * cam.aspect * cam.tanHalfFov;
    float v = (1.0 - 2.0 * (pix.y + 0.5) / HEIGHT) * cam.tanHalfFov;
    vec3 dir = normalize(u * cam.camRight - v * cam.camUp + cam.camForward);
    Ray ray = initRay(cam.camPos, dir);

    vec3 prev = vec3(ray.x, ray.y, ray.z);
    int maxSteps = cam.moving == 1 ? 320 : 800;

    bool hitBH = false, hitD = false, hitObj = false;
    vec4 objCol; vec3 hitC; float hitR;
    vec3 hitDiskPos = vec3(0.0);
    float hitDiskR = 0.0;
    float minR = ray.r;   // closest approach — drives the smooth corona

    for (int i = 0; i < maxSteps; ++i) {
        // round horizon: slight radius jitter only (was 0.88 + 0.24 = very lumpy)
        float rsEff = bhRs * (0.97 + 0.06 * horizonJitter(vec3(ray.x, ray.y, ray.z)));
        if (intercept(ray, rsEff)) { hitBH = true; break; }
        if (ray.r > ESCAPE_R) break;       // [FIX] now actually reachable

        // [PERF] adaptive step: proportional to r — fine near horizon, coarse far away.
        // Inside 3·rs the relative step shrinks 3x: minR is no longer quantized
        // into ~0.15·rs chunks (that quantization made the photon ring boxy).
        float dL = 0.1 * ray.r;
        if (ray.r < 3.0 * bhRs) dL = 0.02 * ray.r;
        // refine near the disk plane so radial sampling is dense (smoother disk)
        float cylR = length(vec2(ray.x, ray.z));
        if (abs(ray.y) < 0.25 * bhRs && cylR < 1.2 * disk_r2) dL = min(dL, 0.06 * disk_r1);
        rk4Step(ray, dL);
        minR = min(minR, ray.r);
        vec3 cur = vec3(ray.x, ray.y, ray.z);

        // disk hit: interpolate the exact y=0 crossing (endpoint-only was boxy)
        if (prev.y * cur.y < 0.0) {
            float t = prev.y / (prev.y - cur.y);
            vec3 hit = mix(prev, cur, t);
            float rc = length(vec2(hit.x, hit.z));
            if (rc >= disk_r1 && rc <= disk_r2) {
                hitDiskPos = hit;
                hitDiskR = rc;
                hitD = true;
                break;
            }
        }
        // [FIX] segment-sphere intersection
        if (interceptObjectSegment(prev, cur, objCol, hitC, hitR)) { hitObj = true; break; }

        prev = cur;
    }

    vec4 color = vec4(0.0);
    if (hitD) {
        // normalized radius across the disk
        float t = (hitDiskR - disk_r1) / (disk_r2 - disk_r1);
        // smooth rim fade: soft inner & outer edges (no hard circular cuts)
        float edge = smoothstep(0.0, 0.07, t) * (1.0 - smoothstep(0.93, 1.0, t));
        // [ANIM] Keplerian differential rotation: inner material orbits faster
        float ang = atan(hitDiskPos.z, hitDiskPos.x);
        float rN = max(t, 0.02);
        float omega = 0.6 / pow(rN, 1.5);   // rad/s (visual clock)
        // 3 trailing spiral arms + fine drifting rings = swirling gas
        float spiral = sin(3.0 * ang - time * omega * 3.0 - rN * 9.0);
        float rings  = sin(rN * 40.0 - time * omega * 2.0);
        float turb   = 0.75 + 0.18 * spiral + 0.10 * rings;
        // [ANIM] relativistic beaming: side moving toward camera is brighter
        vec3 tangentDir = normalize(cross(vec3(0.0, 1.0, 0.0), hitDiskPos));
        float doppler = 1.0 + 0.6 * dot(tangentDir, normalize(cam.camPos - hitDiskPos));
        vec3 dc = vec3(1.0, t, 0.2) * turb * doppler * doppler;
        // fade toward the space background so the rim blends, not cuts
        vec3 bg = vec3(0.01, 0.005, 0.02);
        color = vec4(mix(bg, dc, edge), 1.0);
    } else if (hitBH) {
        float r = ray.r / bhRs;
        // scattered embers on the horizon surface (denser near the edge)
        float n = hash13(floor(vec3(ray.x, ray.y, ray.z) / (bhRs * 0.04)));
        float speck = step(0.72, n) * smoothstep(0.5, 1.0, r);
        // deep singularity color: rich crimson-red core
        vec3 bhColor    = vec3(0.25, 0.0, 0.02);
        // smooth rim glow rising toward the horizon edge (quadratic = soft)
        float rim = smoothstep(0.7, 1.0, r);
        vec3 rimColor   = vec3(1.0, 0.45, 0.1) * rim * rim * 1.5;
        vec3 emberColor = vec3(1.0, 0.5, 0.15) * speck * 2.5;
        color = vec4(bhColor + rimColor + emberColor, 1.0);
    } else if (hitObj) {
        vec3 P = vec3(ray.x, ray.y, ray.z);
        vec3 N = normalize(P - hitC);
        vec3 V = normalize(cam.camPos - P);
        float amb = 0.1, diff = max(dot(N, V), 0.0);
        vec3 shaded = objCol.rgb * (amb + (1.0 - amb) * diff);
        color = vec4(shaded, objCol.a);
    } else {
        // [FIX] hash-based star field keyed on ray direction (was sin-based)
        vec3 star = vec3(0.0);
        float starProb = hash13(dir * 5000.0);
        if (starProb > 0.9995) star = vec3(1.0);

        // [SMOOTH] corona as Gaussian falloff on closest approach:
        // d = 0 exactly at the silhouette -> brightest, fades smoothly outward.
        // exp() is C1-continuous -> no banding (smoothstep chain banded).
        float d  = minR / bhRs - 1.0;
        float corona = exp(-d * d * 0.30);
        // photon ring: soft Gaussian centered at 1.5 rs (photon sphere)
        float pr   = minR / bhRs - 1.5;
        float ring = exp(-pr * pr * 18.0);

        vec3 glow = vec3(0.5, 0.1, 0.6) * corona * 1.2
                  + vec3(1.0, 0.55, 0.1) * ring * 2.0;
        color = vec4(0.01, 0.005, 0.02, 1.0) + vec4(star * 0.5, 0.0) + vec4(glow, 0.0);
    }
    imageStore(outImage, pix, color);
}